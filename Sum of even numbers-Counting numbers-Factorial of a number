1.Find the sum of even numbers from 1 to 10

var sum = 0

for i in 1...10 {
    if i % 2 == 0 {
        sum = sum + i
    }
}

print(sum)

2.Count numbers from 1 to 10

var count = 0

for i in 1...10 {
    count = count + 1
}

print(count)


3.Find the factorial of 5

var fact = 1

for i in 1...5 {
    fact = fact * i
}

print(fact)
